{
  "name": "onliner",
  "scripts": {
    "build": "node tools/fluent.js check && node tools/build.js",
    "build:analyze": "node tools/build.js --analyze",
    "build:inline:analyze": "node tools/build.js --inline --analyze",
    "build:legacy": "node tools/fluent.js check && node tools/build.js --legacy",
    "build:registry:analyze": "node tools/build.js --registry --analyze",
    "watch": "node tools/fluent.js check && node tools/build.js --watch",
    "serve": "http-server . -a 0.0.0.0 -p 5173 -c-1 --cors",
    "serve:https": "http-server . -a 0.0.0.0 -p 5173 -c-1 --cors -S -C .certs/ih35ogb.pem -K .certs/ih35ogb-key.pem",
    "dev": "npm-run-all --parallel watch serve:https",
    "eval:prompts": "node evals/run.js",
    "eval:prompts:self-check": "node evals/run.js --suites evals/self-check/suites --run evals/self-check/editorial.json",
    "eval:observations:self-check": "node evals/run.js --observations evals/self-check/observations",
    "test:telemetry-foundations": "node tools/telemetry-foundations-smoke.js",
    "test:build-registry": "node tools/build-registry-smoke.js",
    "secrets:apply": "node tools/secrets.js",
    "fluent:sync": "node tools/fluent.js sync",
    "fluent:check": "node tools/fluent.js check"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "@fluentui/svg-icons": "1.1.337"
  }
}
